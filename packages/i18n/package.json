{
  "name": "@tokenhood/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Socle i18n : messages ICU de locales/, négociation de la langue, traduction",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/generate.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node scripts/generate.mjs && tsc --noEmit",
    "test": "node scripts/generate.mjs && vitest run"
  },
  "dependencies": {
    "intl-messageformat": "12.1.3"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21"
  }
}
