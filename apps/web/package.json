{
  "name": "@tokenhood/web",
  "version": "0.1.0",
  "private": true,
  "description": "Interface web de Tokenhood (SvelteKit, rendu serveur)",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "svelte-kit sync && vitest run"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lexend": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@tokenhood/i18n": "workspace:*",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "vite": "8.3.4"
  }
}
