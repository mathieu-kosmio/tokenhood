{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokenhood.kosm.io/schemas/2.1/protocol-conformance.schema.json",
  "title": "Tokenhood · tests de conformité du protocole de coordination",
  "description": "Fichier schemas/protocole/conformite.yaml : contexte par défaut, gabarits et cas de test. Chaque cas part d'un état initial (given), enchaîne des opérations datées (steps) et compare réponses et états attendus. Indépendant du transport : le harnais associe chaque opération à son outil MCP ou à sa route REST. Référence : docs/specs/protocole.md (TH-009).",
  "type": "object",
  "required": ["schema_version", "suite", "version", "machine", "document", "defaults", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "suite": { "const": "coordination" },
    "version": { "type": "integer", "minimum": 1 },
    "machine": { "$ref": "common.schema.json#/$defs/relativePath" },
    "document": { "$ref": "common.schema.json#/$defs/relativePath" },
    "defaults": {
      "type": "object",
      "required": ["t0", "projects", "users", "agents", "authorization", "mission", "fixtures"],
      "additionalProperties": false,
      "properties": {
        "t0": { "type": "string", "format": "date-time" },
        "projects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/project" } },
        "users": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/user" },
              "roles": { "type": "array", "items": { "enum": ["mandate", "admin"] } }
            }
          }
        },
        "agent": {
          "description": "Valeurs communes à tous les agents.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "languages": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/lang" } }
          }
        },
        "agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "user", "environment", "model_family"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/agentId" },
              "user": { "$ref": "#/$defs/user" },
              "environment": { "enum": ["workstation", "container", "vm"] },
              "model_family": { "type": "string", "minLength": 1 },
              "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "languages": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/lang" } }
            }
          }
        },
        "authorization": {
          "description": "Gabarit : une autorisation aut_<agent sans préfixe> par agent.",
          "$ref": "#/$defs/authorizationFields"
        },
        "mission": {
          "description": "Valeurs par défaut des missions de given.",
          "$ref": "#/$defs/missionFields"
        },
        "fixtures": {
          "description": "Gabarits désignés par \"@nom\" ou {\"@\": nom, …} dans les entrées.",
          "type": "object",
          "additionalProperties": { "type": "object" }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "user": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
    "time": {
      "description": "Date absolue (RFC 3339), ou décalage par rapport à t0 : \"+10m\", \"-1d\", \"+3h30m\", \"+9m59s\".",
      "anyOf": [
        { "type": "string", "pattern": "^[+-](?=\\d)(\\d+d)?(\\d+h)?(\\d+m)?(\\d+s)?$" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "actor": {
      "description": "Jeton d'agent (agt_…), jeton humain (user:<id>), webhook de la forge, ou plateforme.",
      "type": "string",
      "pattern": "^(agt_[A-Za-z0-9]{3,}|user:[a-z][a-z0-9]*|forge|platform)$"
    },
    "operation": {
      "description": "Identifiant d'opération de schemas/protocole/machine.yaml, ou list_tools (méthode MCP tools/list).",
      "type": "string",
      "pattern": "^[a-z][a-z_]*$"
    },
    "project": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "contract": { "enum": ["active", "suspended", "bootstrap"] },
        "maintainers": { "type": "array", "items": { "$ref": "#/$defs/user" } },
        "flow_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_in_production": { "type": "integer", "minimum": 1 },
            "max_awaiting_review_or_integration": { "type": "integer", "minimum": 1 }
          }
        },
        "usage_report": { "enum": ["required", "optional"] },
        "reciprocal_window": { "type": "integer", "minimum": 0 },
        "feedback_days": { "type": "integer", "minimum": 1 }
      }
    },
    "authorizationFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^aut_[A-Za-z0-9]{3,}$" },
        "projects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "mission_types": {
          "oneOf": [
            { "const": "any" },
            { "type": "array", "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "review": { "type": "boolean" },
        "max_concurrent": { "type": "integer", "minimum": 1 },
        "budget": {
          "type": "object",
          "required": ["unit", "value"],
          "additionalProperties": false,
          "properties": {
            "unit": { "enum": ["tokens", "tokens_eq", "agent_hours", "missions"] },
            "value": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "active_from": { "$ref": "#/$defs/time" },
        "expires_at": { "$ref": "#/$defs/time" },
        "revoked": { "type": "boolean" }
      }
    },
    "missionFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/missionId" },
        "project": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "minLength": 1 },
        "state": { "enum": ["draft", "open", "blocked", "in_progress", "awaiting_decision", "accepted", "integrated", "closed", "cancelled"] },
        "generation": { "type": "integer", "minimum": 0 },
        "attempts": {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["exclusive", "parallel"] },
            "max": { "type": "integer", "minimum": 2 }
          }
        },
        "max_lease_minutes": { "type": "integer", "minimum": 10 },
        "risk": { "$ref": "common.schema.json#/$defs/risk" },
        "environment": { "enum": ["any", "container", "vm"] },
        "reviewers": { "type": "integer", "minimum": 1 },
        "dependencies": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/missionId" } },
        "integrated_at": { "$ref": "#/$defs/time" }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "title", "covers", "rules", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^CT-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "covers": {
          "description": "Couples transition:déclencheur de la machine exercés par le cas.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(T|M|RV)[0-9]{2}:[a-z][a-z_]*$" }
        },
        "rules": {
          "description": "Règles (rules) et invariants d'autorisation (A1…) exercés par le cas.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][0-9]{1,2}$" }
        },
        "given": { "$ref": "#/$defs/given" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "given": {
      "description": "État initial, posé directement par le harnais (fixtures en base), sans passer par les opérations.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "t0": { "type": "string", "format": "date-time" },
        "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
        "missions": {
          "type": "array",
          "items": { "allOf": [{ "$ref": "#/$defs/missionFields" }], "required": ["id"] }
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "mission", "agent", "state", "generation"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/attemptId" },
              "mission": { "$ref": "common.schema.json#/$defs/missionId" },
              "agent": { "$ref": "common.schema.json#/$defs/agentId" },
              "state": { "enum": ["claimed", "awaiting_decision", "submitted", "awaiting_reviewer", "in_review", "changes_requested", "accepted", "rejected", "expired", "released"] },
              "generation": { "type": "integer", "minimum": 1 },
              "contract_version": { "type": "integer", "minimum": 1 },
              "claimed_at": { "$ref": "#/$defs/time" },
              "lease_expires_at": { "$ref": "#/$defs/time" },
              "deadline_at": { "$ref": "#/$defs/time" },
              "active_minutes": { "type": "integer", "minimum": 0 },
              "changes_due_at": { "$ref": "#/$defs/time" },
              "ended_at": { "$ref": "#/$defs/time" },
              "reason": { "type": "string", "minLength": 1 },
              "request": { "type": "string", "pattern": "^req_[A-Za-z0-9]{4,}$" }
            }
          }
        },
        "submissions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "attempt", "state", "contract_version"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/submissionId" },
              "attempt": { "$ref": "common.schema.json#/$defs/attemptId" },
              "state": { "enum": ["current", "outdated", "superseded", "accepted", "rejected", "withdrawn"] },
              "commit": { "$ref": "common.schema.json#/$defs/commitSha" },
              "artifact_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
              "contract_version": { "type": "integer", "minimum": 1 },
              "submitted_at": { "$ref": "#/$defs/time" },
              "decided_verdict": { "enum": ["pass", "changes_requested", "reject"] },
              "approval": { "const": "pending" },
              "rejection_pending_until": { "$ref": "#/$defs/time" }
            }
          }
        },
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "submission", "agent", "state"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^rva_[A-Za-z0-9]{4,}$" },
              "submission": { "$ref": "common.schema.json#/$defs/submissionId" },
              "agent": { "$ref": "common.schema.json#/$defs/agentId" },
              "state": { "enum": ["assigned", "completed", "declined", "expired", "cancelled"] },
              "due_at": { "$ref": "#/$defs/time" }
            }
          }
        },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["submission", "agent", "verdict", "state"],
            "additionalProperties": false,
            "properties": {
              "submission": { "$ref": "common.schema.json#/$defs/submissionId" },
              "agent": { "$ref": "common.schema.json#/$defs/agentId" },
              "verdict": { "enum": ["pass", "changes_requested", "reject"] },
              "commit": { "$ref": "common.schema.json#/$defs/commitSha" },
              "state": { "enum": ["valid", "outdated"] }
            }
          }
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["attempt", "sequence", "summary", "recorded_at"],
            "additionalProperties": false,
            "properties": {
              "attempt": { "$ref": "common.schema.json#/$defs/attemptId" },
              "sequence": { "type": "integer", "minimum": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "recorded_at": { "$ref": "#/$defs/time" }
            }
          }
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "fixture", "state"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^req_[A-Za-z0-9]{4,}$" },
              "fixture": { "type": "string", "minLength": 1 },
              "attempt": { "$ref": "common.schema.json#/$defs/attemptId" },
              "state": { "enum": ["open", "decided"] },
              "decided_at": { "$ref": "#/$defs/time" },
              "blocked_missions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/missionId" } }
            }
          }
        },
        "links": {
          "description": "Liens d'intérêt déclarés entre utilisateurs.",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "$ref": "#/$defs/user" }
          }
        },
        "review_history": {
          "description": "Revues passées : reviewer a vérifié une mission de producer.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reviewer", "producer", "at"],
            "additionalProperties": false,
            "properties": {
              "reviewer": { "$ref": "#/$defs/user" },
              "producer": { "$ref": "#/$defs/user" },
              "at": { "$ref": "#/$defs/time" }
            }
          }
        },
        "authorizations": {
          "description": "Surcharges du gabarit d'autorisation, par identifiant.",
          "type": "array",
          "items": { "allOf": [{ "$ref": "#/$defs/authorizationFields" }], "required": ["id"] }
        }
      }
    },
    "call": {
      "type": "object",
      "required": ["actor", "op", "input"],
      "properties": {
        "label": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "actor": { "$ref": "#/$defs/actor" },
        "entry": {
          "description": "Entrée imposée ; sans elle, le harnais passe par l'entrée de son choix.",
          "enum": ["mcp", "rest"]
        },
        "op": { "$ref": "#/$defs/operation" },
        "input": { "type": "object" },
        "key": {
          "description": "Clé d'idempotence (identifiant de livraison pour la forge).",
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,255}$"
        },
        "if_match": {
          "description": "current : ETag courant de la ressource ; stale : ETag périmé.",
          "enum": ["current", "stale"]
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["at", "expect"],
      "oneOf": [
        {
          "description": "Opération.",
          "allOf": [{ "$ref": "#/$defs/call" }],
          "required": ["op"],
          "not": { "required": ["concurrent"] },
          "properties": { "expect": { "$ref": "#/$defs/expect" } }
        },
        {
          "description": "Opérations concurrentes, lancées au même instant.",
          "required": ["concurrent"],
          "properties": {
            "concurrent": {
              "type": "array",
              "minItems": 2,
              "items": {
                "allOf": [{ "$ref": "#/$defs/call" }],
                "unevaluatedProperties": false
              }
            },
            "expect": { "$ref": "#/$defs/concurrentExpect" }
          }
        },
        {
          "description": "Constat de l'état à un instant, sans opération (transitions datées).",
          "not": { "anyOf": [{ "required": ["op"] }, { "required": ["concurrent"] }] },
          "properties": {
            "expect": {
              "type": "object",
              "required": ["state"],
              "additionalProperties": false,
              "properties": { "state": { "$ref": "#/$defs/state" } }
            }
          }
        }
      ],
      "properties": {
        "at": { "$ref": "#/$defs/time" },
        "concurrent": true
      },
      "unevaluatedProperties": false
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": { "enum": ["ok", "error"] },
        "result_in": { "type": "array", "minItems": 2, "items": { "enum": ["ok", "error"] } },
        "error": { "type": "string", "pattern": "^[a-z][a-z_]*$" },
        "error_in": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z_]*$" } },
        "response": {
          "description": "Comparaison par inclusion ; \"*\" : valeur quelconque non nulle ; null : absente ou nulle ; dates relatives à t0.",
          "type": "object"
        },
        "excludes": {
          "description": "Aucune des valeurs ne figure dans la liste désignée de la réponse (noms d'outils).",
          "type": "object",
          "required": ["path", "values"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "values": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "save": {
          "description": "Variables enregistrées depuis la réponse, utilisables ensuite sous la forme $nom.",
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "state": { "$ref": "#/$defs/state" }
      },
      "oneOf": [
        { "required": ["result"], "not": { "required": ["result_in"] } },
        { "required": ["result_in"], "not": { "required": ["result"] } }
      ],
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "error" } }, "required": ["result"] },
          "then": { "anyOf": [{ "required": ["error"] }, { "required": ["error_in"] }] }
        }
      ]
    },
    "concurrentExpect": {
      "description": "Résultat valable pour tout ordre de sérialisation des opérations concurrentes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "integer", "minimum": 0 },
        "errors": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z_]*$" },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "same_response": {
          "description": "Toutes les opérations réussies renvoient la même réponse.",
          "type": "boolean"
        },
        "results": {
          "description": "Résultat attendu par opération, désignée par son label.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/expect" }
        },
        "one_of": {
          "description": "Issues admises ; l'une d'elles doit être observée.",
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/concurrentExpect" }
        },
        "state": { "$ref": "#/$defs/state" }
      }
    },
    "state": {
      "description": "États attendus après l'étape, par inclusion. Clés : identifiants, ou $variable.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missions": { "type": "object", "additionalProperties": { "type": "object" } },
        "attempts": { "type": "object", "additionalProperties": { "type": "object" } },
        "submissions": { "type": "object", "additionalProperties": { "type": "object" } },
        "assignments": { "type": "object", "additionalProperties": { "type": "object" } },
        "requests": { "type": "object", "additionalProperties": { "type": "object" } }
      }
    }
  }
}
