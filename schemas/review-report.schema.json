{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokenhood.kosm.io/schemas/2.1/review-report.schema.json",
  "title": "Tokenhood · rapport de vérification à périmètre déclaré",
  "description": "Rapport produit par l'agent d'un autre utilisateur, lié à un état immuable du livrable. Référence : docs/specs/verification-croisee.md.",
  "type": "object",
  "required": ["schema_version", "mission", "attempt", "submission", "reviewer_agent", "reviewed_state", "verdict", "criteria", "tests", "risks", "limits"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "mission": { "$ref": "common.schema.json#/$defs/missionId" },
    "attempt": { "$ref": "common.schema.json#/$defs/attemptId" },
    "submission": { "$ref": "common.schema.json#/$defs/submissionId" },
    "reviewer_agent": { "$ref": "common.schema.json#/$defs/agentId" },
    "reviewed_state": {
      "description": "État immuable examiné : toute modification ultérieure invalide le rapport.",
      "type": "object",
      "required": ["contract_version"],
      "anyOf": [{ "required": ["commit"] }, { "required": ["artifact_sha256"] }],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "type": "integer", "minimum": 1 },
        "commit": { "$ref": "common.schema.json#/$defs/commitSha" },
        "artifact_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "references": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "verdict": { "enum": ["pass", "changes_requested", "reject"] },
    "criteria": {
      "description": "Un résultat par exigence du contrat de mission.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement", "result", "evidence"],
        "additionalProperties": false,
        "properties": {
          "requirement": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "not_verified", "uncertain"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tests": {
      "description": "Commandes réellement exécutées par le vérificateur, avec leur code de sortie.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run", "exit_code"],
        "additionalProperties": false,
        "properties": {
          "run": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" },
          "environment": { "type": "string" }
        }
      }
    },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "limits": {
      "description": "Ce que la revue n'a pas vérifié, et ce qui reste incertain. Obligatoire, même vide.",
      "type": "object",
      "required": ["not_verified", "uncertain"],
      "additionalProperties": false,
      "properties": {
        "not_verified": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "uncertain": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "remarks": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "pass" } }, "required": ["verdict"] },
      "then": {
        "properties": {
          "criteria": { "items": { "properties": { "result": { "const": "pass" } } } }
        }
      }
    }
  ]
}
